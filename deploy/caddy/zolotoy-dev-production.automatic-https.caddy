			header Cache-Control "public, max-age=0, must-revalidate"
			rewrite * /demo/index.html
			file_server {
				disable_canonical_uris
			}
		}
		handle @demo_namespace {
			request_header -Range
			request_header -If-None-Match
			request_header -If-Modified-Since
			route {
				# ASSETS binding disables HTML redirects here; /demo/index is real.
				rewrite @demo_index /demo/index.html
				handle @static {
					header Cache-Control "public, max-age=0, must-revalidate"
					file_server {
						disable_canonical_uris
