				}
				header X-Robots-Tag "noindex"
				respond "Not found" 404
			}
		}
		# Native assets decode paths and collapse repeated slashes. This is
		# deliberately after the raw-path Worker namespace matching above.
		rewrite * {path}
		uri path_regexp /{2,} /
		redir @alias {zd_alias}{zd_query} 307
		redir @normalized {uri} 307
		header @cacheable Cache-Control "public, max-age=0, must-revalidate"
		# ASSETS ignores Range rather than returning a partial document.
		request_header -Range
		handle @document {
			rewrite * {zd_document}
			file_server {
				disable_canonical_uris
			}
		}
		handle @static {
			# Pin the Worker MIME: Linux's MIME registry otherwise selects text/xml.
			header /sitemap.xml Content-Type "application/xml"
			file_server {
				disable_canonical_uris
			}
		}
		handle @ru {
			rewrite * /ru/404.html
			file_server {
				status 404
				disable_canonical_uris
			}
		}
		handle {
			rewrite * /404.html
			file_server {
				status 404
				disable_canonical_uris
			}
		}
	}

	handle_errors {
		header X-Robots-Tag "noindex"
		header Cache-Control "no-store"
		respond "Production asset unavailable" {err.status_code}
	}
}
