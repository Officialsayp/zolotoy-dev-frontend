{
  "name": "zolotoy-dev-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Single frontend SPA for the zolotoy.dev technical developer/admin environment",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write src/ e2e/",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "msw:init": "msw init public/ --save",
    "deploy": "npx --yes wrangler@4.102.0 deploy",
    "deploy:preview": "npx --yes wrangler@4.102.0 versions upload"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.78.0",
    "lucide-vue-next": "^0.525.0",
    "msw": "^2.10.3",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.4",
    "vue-tsc": "^2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
