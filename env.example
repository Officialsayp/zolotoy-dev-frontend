# Environment template for zolotoy-dev-frontend.
#
# NOTE: committed as `env.example` (no leading dot) so this template is easy to
# inspect. To use it, copy to a local, git-ignored Vite env file, e.g. `.env.local`
# (mock mode) or `.env` (overrides), and adjust values.

# Runtime API mode. `mock` uses MSW network interception (no Go backend needed).
# `real` targets the live backend hosts configured below.
VITE_API_MODE=mock

# Deployment environment label (informational, shown in the shell when set).
VITE_DEPLOY_ENV=local

# Live backend base URLs (used only when VITE_API_MODE=real).
# Placeholders only — never commit real secrets here.
VITE_ORDER_API_BASE_URL=https://order-api.zolotoy.dev
VITE_AUTH_API_BASE_URL=https://auth-api.zolotoy.dev
VITE_NOTIFICATION_API_BASE_URL=https://notification-api.zolotoy.dev
VITE_SHORTENER_API_BASE_URL=https://shortener-api.zolotoy.dev

# Public short redirect host (shortener module). Placeholder only.
VITE_SHORTENER_PUBLIC_BASE_URL=https://s.zolotoy.dev

# Optional external resource links. Only rendered when the corresponding value is
# a real, configured location. Leave empty to hide the link.
VITE_GITHUB_REPO_URL=
VITE_GRAFANA_URL=
VITE_API_DOCS_URL=
